{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "automation": {
    "claudeCodeIntegration": true,
    "socketControlMode": "allowAll"
  },
  "terminal": {
    "autoResumeAgentSessions": true
  },
  "shortcuts": {
    "bindings": {
      "newSurface": [
        "ctrl+q",
        "c"
      ],
      "closeTab": [
        "ctrl+q",
        "x"
      ],
      "nextSurface": [
        "ctrl+q",
        "n"
      ],
      "prevSurface": [
        "ctrl+q",
        "p"
      ],
      "selectSurfaceByNumber": [
        "ctrl+q",
        "1"
      ],
      "splitRight": [
        "ctrl+q",
        "shift+5"
      ],
      "splitDown": [
        "ctrl+q",
        "shift+quote"
      ],
      "focusLeft": [
        "ctrl+q",
        "h"
      ],
      "focusDown": [
        "ctrl+q",
        "j"
      ],
      "focusUp": [
        "ctrl+q",
        "k"
      ],
      "focusRight": [
        "ctrl+q",
        "l"
      ],
      "toggleSplitZoom": [
        "ctrl+q",
        "z"
      ],
      "toggleTerminalCopyMode": [
        "ctrl+q",
        "["
      ],
      "equalizeSplits": [
        "ctrl+q",
        "space"
      ],
      "focusNextPane": [
        "ctrl+q",
        "o"
      ],
      "focusPreviousPane": [
        "ctrl+q",
        ";"
      ],
      "renameTab": [
        "ctrl+q",
        ","
      ],
      "goToWorkspace": [
        "ctrl+q",
        "s"
      ],
      "prevSidebarTab": [
        "ctrl+q",
        "shift+9"
      ],
      "nextSidebarTab": [
        "ctrl+q",
        "shift+0"
      ],
      "renameWorkspace": [
        "ctrl+q",
        "shift+4"
      ],
      "commandPalette": [
        "ctrl+q",
        "w"
      ]
    }
  }
}
